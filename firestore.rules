rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isPsychologist() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          "agenciactrldigital@gmail.com",
          "psi.josevitorgf@gmail.com",
          "psi.vitorgomes@gmail.com"
        ];
    }

    function isValidAvailability(data) {
      return data.keys().hasAll(['weeklyDays', 'timeSlots', 'sessionDuration', 'blockedDates', 'modalities', 'updatedAt'])
        && data.keys().hasOnly(['weeklyDays', 'timeSlots', 'weeklySchedule', 'dateOverrides', 'sessionDuration', 'blockedDates', 'modalities', 'updatedAt'])
        && data.weeklyDays is list
        && data.weeklyDays.size() <= 7
        && data.timeSlots is list
        && data.timeSlots.size() <= 48
        && data.sessionDuration is int
        && data.sessionDuration >= 20
        && data.sessionDuration <= 120
        && data.blockedDates is list
        && data.blockedDates.size() <= 365
        && data.modalities is list
        && data.modalities.size() == 1
        && data.modalities.hasOnly(['online'])
        && (!('weeklySchedule' in data) || (data.weeklySchedule is map && data.weeklySchedule.size() <= 7))
        && (!('dateOverrides' in data) || data.dateOverrides is map)
        && data.updatedAt == request.time;
    }

    function isValidGroup(data) {
      return data.keys().hasAll(['title', 'scheduleText', 'platformLabel', 'active'])
        && data.keys().hasOnly(['title', 'scheduleText', 'platformLabel', 'description', 'guidelines', 'active'])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.scheduleText is string
        && data.scheduleText.size() <= 160
        && data.platformLabel is string
        && data.platformLabel.size() > 0
        && data.platformLabel.size() <= 120
        && (!('description' in data) || (data.description is string && data.description.size() <= 1200))
        && (!('guidelines' in data) || (data.guidelines is list && data.guidelines.size() <= 20))
        && data.active is bool;
    }

    function isValidPatientFields(data) {
      return data.keys().hasAll([
          'uid', 'email', 'fullName', 'phone', 'birthDate', 'cityState', 'occupation',
          'isMinor', 'emergencyContactName', 'emergencyContactRelation', 'emergencyContactPhone',
          'reasonForTherapy', 'hadPreviousTherapy', 'usesMedication', 'acceptedTerms',
          'profileCompleted', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'fullName', 'phone', 'birthDate', 'cityState', 'occupation',
          'isMinor', 'guardianName', 'guardianPhone',
          'emergencyContactName', 'emergencyContactRelation', 'emergencyContactPhone',
          'reasonForTherapy', 'hadPreviousTherapy', 'previousTherapyDetails',
          'usesMedication', 'medicationDetails', 'acceptedTerms', 'profileCompleted',
          'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.email is string && data.email.size() > 3 && data.email.size() <= 160
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 40
        && data.birthDate is string && data.birthDate.size() == 10 && data.birthDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.cityState is string && data.cityState.size() >= 2 && data.cityState.size() <= 120
        && data.occupation is string && data.occupation.size() >= 2 && data.occupation.size() <= 120
        && data.isMinor is bool
        && (!('guardianName' in data) || (data.guardianName is string && data.guardianName.size() <= 120))
        && (!('guardianPhone' in data) || (data.guardianPhone is string && data.guardianPhone.size() <= 40))
        && (!data.isMinor || (('guardianName' in data) && data.guardianName.size() >= 2 && ('guardianPhone' in data) && data.guardianPhone.size() >= 8))
        && data.emergencyContactName is string && data.emergencyContactName.size() >= 2 && data.emergencyContactName.size() <= 120
        && data.emergencyContactRelation is string && data.emergencyContactRelation.size() >= 2 && data.emergencyContactRelation.size() <= 80
        && data.emergencyContactPhone is string && data.emergencyContactPhone.size() >= 8 && data.emergencyContactPhone.size() <= 40
        && data.reasonForTherapy is string && data.reasonForTherapy.size() >= 3 && data.reasonForTherapy.size() <= 1500
        && data.hadPreviousTherapy is bool
        && (!('previousTherapyDetails' in data) || (data.previousTherapyDetails is string && data.previousTherapyDetails.size() <= 1000))
        && data.usesMedication is bool
        && (!('medicationDetails' in data) || (data.medicationDetails is string && data.medicationDetails.size() <= 1000))
        && data.acceptedTerms == true
        && data.profileCompleted == true;
    }

    function isValidPatientCreate(data, uid) {
      return isValidPatientFields(data)
        && data.uid == uid
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidPatientUpdate(data, uid) {
      return isValidPatientFields(data)
        && data.uid == existing().uid
        && data.uid == uid
        && data.createdAt == existing().createdAt
        && data.updatedAt == request.time;
    }

    function isValidOccupiedSlot(data) {
      return data.keys().hasAll(['date', 'timeSlot', 'createdAt'])
        && data.keys().hasOnly(['date', 'timeSlot', 'createdAt'])
        && data.date is string
        && data.date.size() == 10
        && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.timeSlot is string
        && data.timeSlot.size() == 5
        && data.timeSlot.matches('^\\d{2}:\\d{2}$')
        && data.createdAt == request.time;
    }

    function isValidSlotHold(data) {
      return data.keys().hasAll(['date', 'timeSlot', 'holdToken', 'ownerUid', 'createdAt', 'expiresAt'])
        && data.keys().hasOnly(['date', 'timeSlot', 'holdToken', 'ownerUid', 'createdAt', 'expiresAt'])
        && data.date is string
        && data.date.size() == 10
        && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.timeSlot is string
        && data.timeSlot.size() == 5
        && data.timeSlot.matches('^\\d{2}:\\d{2}$')
        && data.holdToken is string
        && data.holdToken.size() >= 12
        && data.holdToken.size() <= 64
        && data.ownerUid is string
        && data.ownerUid.size() <= 128
        && ((!isSignedIn() && data.ownerUid == '') || (isSignedIn() && data.ownerUid == request.auth.uid))
        && data.createdAt == request.time
        && data.expiresAt is timestamp
        && data.expiresAt > request.time
        && data.expiresAt <= request.time + duration.value(31, 'm');
    }

    function isValidAppointmentCreate(data) {
      return data.keys().hasAll(['date', 'timeSlot', 'modality', 'patientUid', 'patientName', 'patientContact', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['date', 'timeSlot', 'modality', 'patientUid', 'patientName', 'patientContact', 'notes', 'status', 'createdAt', 'updatedAt'])
        && data.date is string
        && data.date.size() == 10
        && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.timeSlot is string
        && data.timeSlot.size() == 5
        && data.timeSlot.matches('^\\d{2}:\\d{2}$')
        && data.modality == 'online'
        && data.patientUid == request.auth.uid
        && data.patientName is string
        && data.patientName.size() >= 2
        && data.patientName.size() <= 120
        && data.patientContact is string
        && data.patientContact.size() >= 6
        && data.patientContact.size() <= 160
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && data.status == 'pending'
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidAppointmentUpdate(data) {
      return data.keys().hasAll(['date', 'timeSlot', 'modality', 'patientName', 'patientContact', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['date', 'timeSlot', 'modality', 'patientUid', 'patientName', 'patientContact', 'notes', 'meetingLink', 'status', 'createdAt', 'updatedAt'])
        && data.date is string
        && data.date.size() == 10
        && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.timeSlot is string
        && data.timeSlot.size() == 5
        && data.timeSlot.matches('^\\d{2}:\\d{2}$')
        && data.modality == 'online'
        && (!('patientUid' in data) || (data.patientUid is string && data.patientUid.size() <= 128))
        && data.patientName is string
        && data.patientName.size() >= 2
        && data.patientName.size() <= 120
        && data.patientContact is string
        && data.patientContact.size() >= 6
        && data.patientContact.size() <= 160
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('meetingLink' in data) || (data.meetingLink is string && data.meetingLink.size() <= 500))
        && data.status in ['pending', 'confirmed', 'completed', 'cancelled', 'rescheduled']
        && data.updatedAt == request.time;
    }

    match /availability/{docId} {
      allow get: if isValidId(docId);
      allow list: if true;
      allow create, update: if isValidId(docId) && isPsychologist() && isValidAvailability(incoming());
      allow delete: if isValidId(docId) && isPsychologist();
    }

    match /groups/{groupId} {
      allow get: if isValidId(groupId);
      allow list: if true;
      allow create, update: if isValidId(groupId) && isPsychologist() && isValidGroup(incoming());
      allow delete: if isValidId(groupId) && isPsychologist();
    }

    match /patients/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isPsychologist());
      allow list: if isPsychologist();
      allow create: if isValidId(uid) && isOwner(uid) && isValidPatientCreate(incoming(), uid);
      allow update: if isValidId(uid) && isOwner(uid) && isValidPatientUpdate(incoming(), uid);
      allow delete: if isValidId(uid) && isPsychologist();
    }

    match /occupiedSlots/{slotId} {
      allow get: if isValidId(slotId);
      allow list: if true;
      allow create: if isValidId(slotId) && isSignedIn() && isValidOccupiedSlot(incoming());
      allow update: if isValidId(slotId) && isPsychologist() && isValidOccupiedSlot(incoming());
      allow delete: if isValidId(slotId) && isPsychologist();
    }

    match /slotHolds/{slotId} {
      allow get: if isValidId(slotId);
      allow list: if true;
      allow create: if isValidId(slotId) && isValidSlotHold(incoming());
      allow update: if isValidId(slotId) && isValidSlotHold(incoming()) && (existing().expiresAt <= request.time || (isSignedIn() && existing().ownerUid == request.auth.uid));
      allow delete: if isValidId(slotId) && (isPsychologist() || existing().expiresAt <= request.time || (isSignedIn() && (existing().ownerUid == request.auth.uid || existsAfter(/databases/$(database)/documents/occupiedSlots/$(slotId)))));
    }

    match /appointments/{appointmentId} {
      allow get: if isValidId(appointmentId) && (isPsychologist() || (isSignedIn() && 'patientUid' in existing() && existing().patientUid == request.auth.uid));
      allow list: if isPsychologist() || (isSignedIn() && 'patientUid' in resource.data && resource.data.patientUid == request.auth.uid);
      allow create: if isValidId(appointmentId) && isSignedIn() && isValidAppointmentCreate(incoming());
      allow update: if isValidId(appointmentId)
        && isPsychologist()
        && isValidAppointmentUpdate(incoming())
        && (!('patientUid' in existing()) || ('patientUid' in incoming() && incoming().patientUid == existing().patientUid))
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'meetingLink', 'updatedAt']);
      allow delete: if isValidId(appointmentId) && isPsychologist();
    }
  }
}
